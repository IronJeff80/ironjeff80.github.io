---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Community | 2 Smokin' Barrels"
        description="Check out the incredible creators, channels, and friends of the community!"
        image="https://2smokinbarrels.com/images/community-banner.jpg"
    >
    <main class="container">
        <h1 class="page-title">Community</h1>
        <div class="highlight-box">
            <p>
                <span class="highlight-text">Check out the incredible creators, channels, and friends of the community!</span>
            </p>
        </div>

        <!-- ============================================== -->
        <!-- FEATURED STREAMERS                             -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            Featured Creators
        </h3>
        
        <div class="grid grid-creators">
            
            <!-- Official Nugzz Crew -->
            <div class="card card-center">
                <img src="/images/community/nugzz.jpg" alt="Official Nugzz Crew" class="avatar-img avatar-lg">
                <h3>Official Nugzz Crew</h3>
                <p>
                    An amazing collective creating fantastic content. Check out their official site and latest YouTube uploads!
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Streamer.bot</span></span>
                </div>

                <div class="btn-row">
                    <a href="https://officialnugzzcrew.com/" target="_blank" class="cmd-btn">Website</a>
                    <a href="https://www.youtube.com/@OfficialNugzzCrew" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                </div>
            </div>

            <!-- Haunter -->
            <div class="card card-center">
                <img src="/images/community/haunter.jpg" alt="Haunter" class="avatar-img avatar-lg">
                <h3>Haunter</h3>
                <p>
                    Awesome content creator bringing great vibes and entertainment to the community.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Streamer.bot</span></span>
                </div>

                <div class="btn-row">
                    <a href="https://www.youtube.com/@haunter56" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    <a href="https://www.twitch.tv/haunter_56" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- ENGLISH / US CREATORS                          -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            English Creators
        </h3>
        
        <div class="grid grid-creators">
            
            <!-- Leslie Cheyanne -->
            <div class="card card-center">
                <img src="/images/community/leslie.jpg" alt="Leslie Cheyanne" class="avatar-img avatar-lg">
                <h3>Leslie Cheyanne</h3>
                <p>
                    Live streaming great vibes, fun chats, and awesome gameplay. Drop by Twitch and say hello!
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-inactive">Mic: <span class="status-no">&#10007;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.twitch.tv/lesliecheyanne" target="_blank" class="cmd-btn btn-twitch btn-full">Twitch Channel</a>
            </div>

            <!-- Big Cat -->
            <div class="card card-center">
                <img src="/images/community/bigcat.jpg" alt="Big Cat" class="avatar-img avatar-lg">
                <h3>Big Cat</h3>
                <p>
                    Bringing high-energy streams and interactive moments to the community.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Mix-It-Up</span></span>
                </div>

                <a href="https://www.twitch.tv/bigcat615931" target="_blank" class="cmd-btn btn-twitch btn-full">Twitch Channel</a>
            </div>

            <!-- Anne Williams -->
            <div class="card card-center">
                <img src="/images/community/anne.jpg" alt="Anne Williams" class="avatar-img avatar-lg">
                <h3>Anne Williams</h3>
                <p>
                    An incredibly welcoming stream featuring a beautiful community built on friendship.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-inactive">Mic: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Mix-It-Up</span></span>
                </div>

                <a href="https://www.twitch.tv/anne_williamss" target="_blank" class="cmd-btn btn-twitch btn-full">Twitch Channel</a>
            </div>

            <!-- Aidan Ketch -->
            <div class="card card-center">
                <img src="/images/community/aidan.jpg" alt="Aidan Ketch" class="avatar-img avatar-lg">
                <h3>Aidan Ketch</h3>
                <p>
                    Bringing you great gameplay and high-quality streaming content. Catch the newest videos over on YouTube.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@AidanKetch" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- Creepy King -->
            <div class="card card-center">
                <img src="/images/community/creepy.jpg" alt="Creepy King" class="avatar-img avatar-lg">
                <h3>Creepy King</h3>
                <p>
                    A fantastic channel filled with incredible content and a welcoming community.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@CREEPY1825KING" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- Exzumi -->
            <div class="card card-center">
                <img src="/images/community/exzumi.jpg" alt="Exzumi" class="avatar-img avatar-lg">
                <h3>Exzumi</h3>
                <p>
                    Dive into engaging gameplay and chill streams. Don't miss out on the latest uploads!
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@Exzumi" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- High Guy Gaming -->
            <div class="card card-center">
                <img src="/images/community/highguy.jpg" alt="High Guy Gaming" class="avatar-img avatar-lg">
                <h3>High Guy Gaming</h3>
                <p>
                    High-energy gameplay and incredible interactions powered by custom stream integrations.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">StreamFog</span></span>
                </div>

                <a href="https://www.youtube.com/@HighGuyGaming" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>
            
            <!-- Big Dog Triple OG -->
            <div class="card card-center">
                <img src="/images/community/bigdog.jpg" alt="Big Dog Triple OG" class="avatar-img avatar-lg">
                <h3>Big Dog Triple OG</h3>
                <p>
                    Delivering top-notch entertainment and great gameplay. Don't miss the latest streams!
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@Bigdog_badassmc" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- Okami -->
            <div class="card card-center">
                <img src="/images/community/okami.jpg" alt="Okami" class="avatar-img avatar-lg">
                <h3>Okami</h3>
                <p>
                    Dive into epic adventures and highly interactive streams powered by custom automation.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-inactive">Mic: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Streamer.bot</span></span>
                </div>

                <a href="https://www.youtube.com/@Kuku-Percs" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

        </div>

        <!-- ============================================== -->
        <!-- BRAZILIAN PORTUGUESE CREATORS                  -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            Brazilian Portuguese Creators
        </h3>

        <div class="grid grid-creators">

            <!-- Billy Ricketts -->
            <div class="card card-center">
                <img src="/images/community/billy.jpg" alt="Billy Ricketts" class="avatar-img avatar-lg">
                <h3>Billy Ricketts</h3>
                <p>
                    Check out Billy's latest streams and videos for top-tier gameplay and fun interactions.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Integrations: <span class="status-yes">Streamer.bot</span></span>
                </div>

                <a href="https://www.youtube.com/@billyricketts" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- LordBlackCA -->
            <div class="card card-center">
                <img src="/images/community/lordblack.jpg" alt="LordBlackCA" class="avatar-img avatar-lg">
                <h3>LordBlackCA</h3>
                <p>
                    Incredible Red Dead Online content and engaging streams for the Portuguese speaking community.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-active">Face: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@LordBlackCA" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

            <!-- Mr. Braga -->
            <div class="card card-center">
                <img src="/images/community/braga.jpg" alt="Mr. Braga" class="avatar-img avatar-lg">
                <h3>Mr. Braga</h3>
                <p>
                    Join the action-packed adventures and great discussions on Red Dead Online.
                </p>
                
                <div class="stream-meta">
                    <span class="meta-inactive">Face: <span class="status-no">&#10007;</span></span>
                    <span class="meta-active">Mic: <span class="status-yes">&#10003;</span></span>
                    <span class="meta-inactive">Integrations: <span class="status-no">None</span></span>
                </div>

                <a href="https://www.youtube.com/@Mr._Braga" target="_blank" class="cmd-btn btn-youtube btn-full">YouTube Channel</a>
            </div>

        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>
