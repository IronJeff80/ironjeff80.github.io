---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | 2 Smokin' Barrels">
    <main class="container contact-card">
        <h1 class="page-title">Contact Us</h1>
        <p class="contact-intro">
            Have a question, feedback, or a request? Use the form below to reach out. 
            We try to respond to all community inquiries within 48 hours.
        </p>

        <form action="https://api.web3forms.com/submit" method="POST" class="contact-form">
            <input type="hidden" name="access_key" value="ac03e2e3-2ea1-487c-ae65-3301bf19416e">
            <input type="hidden" name="redirect" value="https://2smokinbarrels.com/thank-you">

            <label>Name</label>
            <input type="text" name="name" required>

            <label>Email</label>
            <input type="email" name="email" required>

            <label>Message</label>
            <textarea name="message" rows="5" required></textarea>

            <button type="submit" class="cmd-btn">
                Send Message
            </button>
        </form>
    </main>
</Layout>
