<Layout title="Royalty Free Music | 2 Smokin' Barrels"
        description="Download and use these royalty-free instrumental tracks and stems for your streams and content. "
        image="https://2smokinbarrels.com/images/music-banner.jpg"
    >
    <main class="container">
        <h1 class="page-title">Royalty Free Music</h1>
        <div class="highlight-box highlight-box-spaced">
            <p>
                <span class="highlight-text">Download and use these royalty-free instrumental tracks and stems for your streams and content.</span>
            </p>
        </div>

        <!-- View Controls -->
        <div class="view-toggle-container">
            <span class="view-label">Layout:</span>
            <button class="cmd-btn view-btn active" data-view="grid" aria-label="Gallery View">Gallery</button>
            <button class="cmd-btn btn-secondary view-btn" data-view="list" aria-label="List View">List</button>
        </div>

        <!-- Albums Grid -->
        <div id="album-container" class="grid grid-albums">
            
            {albums.map((album) => (
                <div class="card">
                    <img 
                        src={`/images/albums/${album.title}.webp`} 
                        alt={`${album.title} Cover Art`} 
                        class="album-cover"
                        loading="lazy"
                    />

                    <!-- Wrapper added for List view flexbox layout -->
                    <div class="album-info">
                        <h3 class="album-title">{album.title}</h3>
                        
                        <span class="badge">{album.genre}</span>
                        <p>
                            {album.description}
                        </p>
                        <div class="album-actions">
                            <a href={album.folderUrl} target="_blank" class="cmd-btn btn-full">
                                Download
                            </a>
                        </div>
                        
                        <details class="tracklist-details">
                            <summary>
                                View Tracks ({album.tracks.length})
                            </summary>
                            <ul class="tracklist">
                                {album.tracks.map((track, index) => (
                                    <li class="tracklist-item">
                                        <span>{index + 1}. {track.replace('.mp3', '')}</span>
                                    </li>
                                ))}
                            </ul>
                        </details>
                    </div>
                </div>
            ))}
        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>