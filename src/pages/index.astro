---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import offlineImg from '../assets/images/offline.webp';

// Add or swap your past stream YouTube Video IDs and titles here
const pastStreams = [
    { id: "olP7h9B7V90", title: "Lake Isabella Gold Glitch — Live Breakdown", game: "Red Dead Online" },
    { id: "sf41Gy08b-I", title: "Rapid Spawn All Treasure Maps Session", game: "Red Dead Online" },
    { id: "puidk5oZY7o", title: "Fast Gold Bar Run & Chat Mini-Games", game: "Red Dead Online" },
    { id: "R6Hcy5KiiPk", title: "Legendary Pelt Duplication & Posse Up", game: "Red Dead Online" }
];
---

<Layout title="2 Smokin' Barrels | Stream Tools & Extensions">

    <main class="container">
        <header class="page-header">
            <h1 class="page-title">In Smokin' We Trust</h1>

            <div class="highlight-box">
                <p>
                    <span class="highlight-text">Custom extensions and technical tools for the Red Dead & GTA community.</span>
                    <span class="highlight-subtext">Built for live broadcast interactivity, zero-latency OBS Browser Sources, Streamer.bot WebSocket automation, and tested RDO gold & pelt mechanics.</span>
                </p>
            </div>
        </header>

        <div>
            <div class="stream-header-row">
                <h2 class="section-title">Interactive Stream Ecosystem</h2>
                <button type="button" id="theatre-toggle-btn" class="cmd-btn btn-secondary theatre-btn" onclick="toggleTheatreMode()">
                    <i class="fas fa-expand"></i> <span>Theater Mode</span>
                </button>
            </div>

            <div class="stream-container" id="stream-layout-grid">
                <div class="video-wrapper" id="video-wrapper">
                    <Image id="offline-placeholder" src={offlineImg} alt="Stream is currently offline" width={800} height={450} />
                    <iframe id="yt-video-frame" src="https://www.youtube.com/embed/live_stream?channel=UCbflkZl3HSQVyVW153f2Z3A" allowfullscreen></iframe>
                </div>

                <!-- Live Chat (Shown automatically when stream is Live or Scheduled) -->
                <div class="chat-wrapper" id="chat-wrapper">
                    <iframe id="yt-chat-frame" src="about:blank"></iframe>
                </div>

                <!-- Past Streams / VODs (Fills the right gap when stream is Offline) -->
                <div class="vod-wrapper" id="vod-wrapper">
                    <div class="vod-header">
                        <div class="vod-header-title">
                            <i class="fas fa-film"></i>
                            <span>Previous Streams & Highlights</span>
                        </div>
                        <button type="button" id="vod-reset-btn" class="vod-reset-btn" onclick="resetToOfflineSlate()" title="Close Player">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="vod-list">
                        {pastStreams.map((vod) => (
                            <button type="button" class="vod-item" data-video-id={vod.id} onclick={`playVodInStage('${vod.id}', this)`}>
                                <div class="vod-thumb-wrap">
                                    <img src={`https://img.youtube.com/vi/${vod.id}/mqdefault.jpg`} alt={vod.title} loading="lazy" />
                                    <span class="vod-play-overlay"><i class="fas fa-play"></i></span>
                                </div>
                                <div class="vod-info">
                                    <span class="vod-game">{vod.game}</span>
                                    <h4 class="vod-title">{vod.title}</h4>
                                </div>
                            </button>
                        ))}
                    </div>
                </div>
            </div>

            <div class="command-center">
                <div class="command-center-header">
                    <h3>Command Center</h3>
                    <div class="command-header-controls">
                        <select id="album-select" class="album-dropdown stream-cmd" onchange="if(this.value){ sendAction('Select Album', this.value); this.selectedIndex = 0; }" disabled>
                            <option value="">Choose Album</option>
                            <option value="Breakin">Breakin & Scratchin</option>
                            <option value="Careless Desires">80s Retro Vibes</option>
                            <option value="RDO Camp SOngs">RDO Camp Songs</option>
                            <option value="Halloween">Halloween Vibes</option>
                            <option value="Hot List">Chat Favorites</option>
                            <option value="Midnight Ride">80s Driving Vibes</option>
                            <option value="Pipa">Orient Meditation</option>
                            <option value="Rock">Rock N Roll Vibes</option>
                            <option value="Western">Western Vibes</option>
                        </select>
                        <div class="media-bar header-media">
                            <button class="cmd-btn media-btn stream-cmd" onclick="sendAction('Media Previous')" title="Previous" disabled><i class="fas fa-step-backward"></i></button>
                            <button class="cmd-btn media-btn stream-cmd" onclick="sendAction('Media Stop')" title="Stop" disabled><i class="fas fa-stop"></i></button>
                            <button class="cmd-btn media-btn stream-cmd" onclick="sendAction('Media Play')" title="Play" disabled><i class="fas fa-play"></i></button>
                            <button class="cmd-btn media-btn stream-cmd" onclick="sendAction('Media Pause')" title="Pause" disabled><i class="fas fa-pause"></i></button>
                            <button class="cmd-btn media-btn stream-cmd" onclick="sendAction('Media Skip')" title="Skip" disabled><i class="fas fa-step-forward"></i></button>
                        </div>
                    </div>
                </div>
                <p id="status-msg">Connecting to Streamer.bot...</p>
                <div id="owner-debug-tools" class="owner-debug-tools" style="display:none;">
                    <label class="owner-debug-toggle">
                        <input type="checkbox" id="owner-force-enable">
                        <span>Force commands enabled (offline preview)</span>
                    </label>
                    <div class="owner-video-override">
                        <label for="owner-video-id">Unlisted / Debug Video ID:</label>
                        <input type="text" id="owner-video-id" placeholder="e.g. dQw4w9WgXcQ" maxlength="20">
                        <button type="button" id="owner-load-video" class="cmd-btn">Load</button>
                        <button type="button" id="owner-clear-video" class="cmd-btn">Clear</button>
                    </div>
                </div>
                
                <h4 class="collapsible-header collapsed" onclick="toggleSection(this)">
                    Fun Stuff & Games <i class="fas fa-chevron-down transition-icon"></i>
                </h4>
                <div class="btn-grid collapsible-content collapsed">
                    <button class="cmd-btn stream-cmd" onclick="sendAction('2) Join Game (Command)')" disabled>Join Whammy</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Plinko 2 -  Join Game (Command)')" disabled>Join Plinko</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Barrel Roll')" disabled>Barrel Roll</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Haduken')" disabled>Haduken</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Shoryuken')" disabled>Shoryuken</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Scorpion')" disabled>Scorpion</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop')" disabled>BallDrop</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop BlackHole')" disabled>BallDrop BlackHole</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('BallDrop Explode')" disabled>BallDrop Explode</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Bombs Away')" disabled>Bombs Away</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Skeletor')" disabled>Skeletor</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('GTA Wasted')" disabled>GTA Wasted</button>
                </div>

                <h4 class="collapsible-header collapsed" onclick="toggleSection(this)">
                    Theme Colors <i class="fas fa-chevron-down transition-icon"></i>
                </h4>
                <div class="btn-grid collapsible-content collapsed theme-colors-grid">
                    <button class="cmd-btn stream-cmd theme-btn theme-aurora" onclick="sendAction('Aurora Theme', 'Aurora Theme')" disabled>Aurora</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-blue" onclick="sendAction('Blue Theme', 'Blue Theme')" disabled>Blue</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-bubblegum" onclick="sendAction('Bubblegum Theme', 'Bubblegum Theme')" disabled>Bubblegum</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-cottoncandy" onclick="sendAction('Cotton Candy Theme', 'Cotton Candy Theme')" disabled>Cotton Candy</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-crimson" onclick="sendAction('Crimson Theme', 'Crimson Theme')" disabled>Crimson</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-flare" onclick="sendAction('Flare Theme', 'Flare Theme')" disabled>Flare</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-fruity" onclick="sendAction('Fruity Theme', 'Fruity Theme')" disabled>Fruity</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-green" onclick="sendAction('Green Theme', 'Green Theme')" disabled>Green</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-illusion" onclick="sendAction('Illusion Theme', 'Illusion Theme')" disabled>Illusion</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-marine" onclick="sendAction('Marine Theme', 'Marine Theme')" disabled>Marine</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-orange" onclick="sendAction('Orange Theme', 'Orange Theme')" disabled>Orange</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-outrun" onclick="sendAction('Outrun Theme', 'Outrun Theme')" disabled>Outrun</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-party" onclick="sendAction('Party Theme', 'Party Theme')" disabled>Party</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-pastel" onclick="sendAction('Pastel Theme', 'Pastel Theme')" disabled>Pastel</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-pink" onclick="sendAction('Pink Theme', 'Pink Theme')" disabled>Pink</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-plum" onclick="sendAction('Plum Theme', 'Plum Theme')" disabled>Plum</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-rainbow" onclick="sendAction('Rainbow Theme', 'Rainbow Theme')" disabled>Rainbow</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-red" onclick="sendAction('Red Theme', 'Red Theme')" disabled>Red</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-retro" onclick="sendAction('Retro Theme', 'Retro Theme')" disabled>Retro</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-sunset" onclick="sendAction('Sunset Theme', 'Sunset Theme')" disabled>Sunset</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-swirl" onclick="sendAction('Swirl Theme', 'Swirl Theme')" disabled>Swirl</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-vaporwave" onclick="sendAction('Vaporwave Theme', 'Vaporwave Theme')" disabled>Vaporwave</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-white" onclick="sendAction('White Theme', 'White Theme')" disabled>White</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-yellow" onclick="sendAction('Yellow Theme', 'Yellow Theme')" disabled>Yellow</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-rdr" onclick="sendAction('RDR Theme', 'RDR Theme')" disabled>RDR2</button>
                    <button class="cmd-btn stream-cmd theme-btn theme-gta6" onclick="sendAction('VI Theme', 'VI Theme')" disabled>GTA VI</button>
                </div>

                <h4 class="collapsible-header collapsed" onclick="toggleSection(this)">
                    GamePlay Filters <i class="fas fa-chevron-down transition-icon"></i>
                </h4>
                <div class="btn-grid collapsible-content collapsed">
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Black & White', 'Filter Black & White')" disabled>Black & White</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Drunk', 'Filter Drunk')" disabled>Drunk</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Fisheye', 'Filter Fisheye')" disabled>Fisheye</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Fisheye Flip', 'Filter Fisheye Flip')" disabled>Fisheye Flip</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Glitch', 'Filter Glitch')" disabled>Glitch</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Matrix', 'Filter Matrix')" disabled>Matrix</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Mirror', 'Filter Mirror')" disabled>Mirror</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Mirror Flip', 'Filter Mirror Flip')" disabled>Mirror Flip</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Pixels', 'Filter Pixels')" disabled>Pixels</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Pulse', 'Filter Pulse')" disabled>Pulse</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Rain', 'Filter Rain')" disabled>Rain</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Sephia', 'Filter Sephia')" disabled>Sephia</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Shake', 'Filter Shake')" disabled>Shake</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Speed Lines', 'Filter Speed Lines')" disabled>Speed Lines</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Spin', 'Filter Spin')" disabled>Spin</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Thermal Quake', 'Filter Thermal Quake')" disabled>Thermal Quake</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Thermal', 'Filter Thermal')" disabled>Thermal</button>
                    <button class="cmd-btn stream-cmd" onclick="sendAction('Filter Upside Down', 'Filter Upside Down')" disabled>Upside Down</button>
                </div>

                <h4 class="collapsible-header collapsed" onclick="toggleSection(this)">
                    Camera Control <i class="fas fa-chevron-down transition-icon"></i>
                </h4>
                <div class="collapsible-content collapsed camera-control-section">
                    <div class="camera-dropdowns">
                        <div class="camera-dropdown-group">
                            <label for="camera-position">Position</label>
                            <select id="camera-position" class="album-dropdown stream-cmd" onchange="if(this.value){ sendAction(this.value); this.selectedIndex = 0; }" disabled>
                                <option value="">Choose Position</option>
                                <option value="01 - Command - Redeem Camera Top Left">Top Left</option>
                                <option value="02 - Command - Redeem Camera Top Center">Top Center</option>
                                <option value="03 - Command - Redeem Camera Top Right">Top Right</option>
                                <option value="04 - Command - Redeem Camera Middle Left">Mid Left</option>
                                <option value="05 - Command - Redeem Camera Middle Center">Mid Center</option>
                                <option value="06 - Command - Redeem Camera Middle Right">Mid Right</option>
                                <option value="07 - Command - Redeem Camera Bottom Left">Bottom Left</option>
                                <option value="08 - Command - Redeem Camera Bottom Center">Bottom Center</option>
                                <option value="09 - Command - Redeem Camera Bottom Right">Bottom Right</option>
                                <option value="10 - Command - Redeem Camera Inline Right">Right Align</option>
                                <option value="0 - Command - Redeem Camera RDO Default">Red Dead Spot</option>
                                <option value="000 - Command - Redeem Camera GTA Default">GTA Spot</option>
                                <option value="00 - Command - Redeem Camera Enlarged">Full Center</option>
                            </select>
                        </div>
                        <div class="camera-dropdown-group">
                            <label for="camera-style">Style</label>
                            <select id="camera-style" class="album-dropdown stream-cmd" onchange="if(this.value){ sendAction(this.value); this.selectedIndex = 0; }" disabled>
                                <option value="">Choose Style</option>
                                <option value="0B - Command - Redeem Camera Design Glitch Box">RDR Compass</option>
                                <option value="0C - Command Redeem - Camera Design RDO Compass">GTA Glitch Box</option>
                                <option value="0D - Command Redeem - Camera Design Inline">Inline Basic</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <h2 class="section-title">Red Dead Online Glitches</h2>
            <div class="glitch-grid">
                <div class="glitch-card">
                    <h4>Lake Isabella COMPLETE Guide</h4>
                    <a href="https://www.youtube.com/watch?v=olP7h9B7V90" target="_blank"><img class="glitch-thumb" src="https://img.youtube.com/vi/olP7h9B7V90/hqdefault.jpg" alt="Lake Isabella Gold Glitch"></a>
                </div>
                <div class="glitch-card">
                    <h4>Rapid Spawn All Treasure Maps</h4>
                    <a href="https://www.youtube.com/watch?v=sf41Gy08b-I" target="_blank"><img class="glitch-thumb" src="https://img.youtube.com/vi/sf41Gy08b-I/hqdefault.jpg" alt="Red Dead Treasure Map Glitch"></a>
                </div>
                <div class="glitch-card">
                    <h4>Lake Isabella Gold Glitch</h4>
                    <a href="https://www.youtube.com/watch?v=puidk5oZY7o" target="_blank"><img class="glitch-thumb" src="https://img.youtube.com/vi/puidk5oZY7o/hqdefault.jpg" alt="Lake Isabella Gold Bar Glitch"></a>
                </div>
                <div class="glitch-card">
                    <h4>How to: Dupe Large Pelts</h4>
                    <a href="https://www.youtube.com/watch?v=R6Hcy5KiiPk" target="_blank"><img class="glitch-thumb" src="https://img.youtube.com/vi/R6Hcy5KiiPk/hqdefault.jpg" alt="Red Dead Pelt Duplication"></a>
                </div>
            </div>
        </div>

        <div>
            <h2 class="section-title">Available Projects</h2>
            <div class="grid">

                <!-- GTA VI Reveal Overlay -->
                <div class="card">
                    <a href="https://2smokinbarrels.com/gta6-overlay/" target="_blank" rel="noopener noreferrer" class="card-stretch-link">
                        <span class="badge">Overlay</span>
                        <h3 class="card-title-bebas">GTA VI Reveal Overlay</h3>
                        <div class="card-footer">
                            <span class="card-link">CREATE <i class="fas fa-external-link-alt"></i></span>
                        </div>
                    </a>
                </div>

                <!-- OBS Duel Game -->
                <div class="card">
                    <a href="https://github.com/IronJeff80/OBS-Duel-Game" target="_blank" rel="noopener noreferrer" class="card-stretch-link">
                        <span class="badge">Mini-Game</span>
                        <h3 class="card-title-bebas">OBS Duel Game</h3>
                        <div class="card-footer">
                            <span class="card-link">Download Files <i class="fas fa-external-link-alt"></i></span>
                        </div>
                    </a>
                </div>

                <!-- GTA OBS Widget -->
                <div class="card">
                    <div>
                        <span class="badge">Overlay</span>
                        <h3 class="card-title-bebas">GTA OBS Widget</h3>
                    </div>
                    <div class="card-footer">
                        <a href="https://2smokinbarrels.com/gtawidget/setup.html" target="_blank" rel="noopener noreferrer" class="card-link">
                            Configure <i class="fas fa-external-link-alt"></i>
                        </a>
                        <a href="https://github.com/IronJeff80/gtawidget" target="_blank" rel="noopener noreferrer" class="card-link">
                            Documentation <i class="fas fa-book"></i>
                        </a>
                    </div>
                </div>

                <!-- RDO Events OBS Overlay -->
                <div class="card">
                    <a href="https://github.com/IronJeff80/reddeadoverlay" target="_blank" rel="noopener noreferrer" class="card-stretch-link">
                        <span class="badge">Overlay</span>
                        <h3 class="card-title-bebas">RDO Events OBS Overlay</h3>
                        <div class="card-footer">
                            <span class="card-link">Configure <i class="fas fa-external-link-alt"></i></span>
                        </div>
                    </a>
                    <div class="copy-link-container">
                        <input type="text" class="copy-input" value="https://2smokinbarrels.com/reddeadoverlay/" readonly id="rdo-link">
                        <button class="copy-btn" onclick="copyLink('rdo-link')"><i class="fas fa-copy"></i></button>
                    </div>
                </div>

            </div>
        </div>
    </main>
</Layout>