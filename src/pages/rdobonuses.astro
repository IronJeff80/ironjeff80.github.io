---
import Layout from '../layouts/Layout.astro';
---

<Layout
        title="Red Dead Bonuses | 2 Smokin' Barrels"
        description="Red Dead Online gets spooky this month with 4X rewards on Strange Tales of the West, Triple Rewards in All Hallows' Call to Arms, and the return of Halloween Pass 2."
        image="https://2smokinbarrels.com/images/rdo-bonuses-banner.jpg"
    >
    <main class="container">
        
        <header class="page-header">
            <h1 class="page-title">Red Dead Monthly</h1>
            <p class="date-range">October 6, 2026 — November 2, 2026</p>
            
            <div class="highlight-box highlight-box-left">
                <p>
                    Red Dead Online gets spooky this month with <span class="highlight-text">4X RDO$, Gold & XP</span> on Strange Tales of the West Telegram Missions, plus <span class="highlight-pink">3X RDO$, Gold & XP</span> in All Hallows' Call to Arms. 
                    Naturalist Sample Sales are also paying out <span class="highlight-pink">3X RDO$, XP & Role XP</span>, alongside the return of <span class="highlight-text">Halloween Pass 2</span>!
                </p>
            </div>
        </header>

        <div class="bonus-grid">
            <div class="bonus-card">
                <h3>Current Bonuses</h3>
                <div class="bonus-item"><span class="multiplier">4X</span> <strong>RDO$, Gold & XP</strong> on Strange Tales of the West Telegram Missions</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, Gold & XP</strong> on All Hallows' Call to Arms</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, XP & Role XP</strong> on Naturalist Sample Sales</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Featured Series</div>
            </div>

            <div class="bonus-card">
                <h3>Monthly Rewards</h3>
                <div class="bonus-item"><strong>Red Fernwater Coat:</strong> Log in and play to receive.</div>
                <div class="bonus-item"><strong>Irontooth Mask:</strong> Log in as a Naturalist.</div>
                <div class="bonus-item"><strong>Best Shot Emote:</strong> Hunt or sample a Legendary Animal.</div>
                <div class="bonus-item"><strong>Rowberrow Outfit & Air Banjo Emote:</strong> Reach Wave 5 in All Hallows' Call to Arms.</div>
                <div class="bonus-item"><strong>Beat Chest Emote & 1 Gold Bar:</strong> Reach Wave 10 in All Hallows' Call to Arms.</div>
            </div>

            <div class="bonus-card">
                <h3>Weekly Rewards</h3>
                <div class="bonus-item"><span class="bonus-date">Oct 6 - 12</span><br>Complete a Sample Sale: <strong>Free Coat Reward</strong></div>
                <div class="bonus-item"><span class="bonus-date">Oct 13 - 19</span><br>Win in the Featured Series: <strong>North Clingman Treasure Map</strong></div>
                <div class="bonus-item"><span class="bonus-date">Oct 20 - 26</span><br>Complete any Blood Money Contract: <strong>Free Weapon Reward</strong></div>
                <div class="bonus-item"><span class="bonus-date">Oct 27 - Nov 2</span><br>Play All Hallows' Call to Arms: <strong>Orange Benbow Jacket</strong></div>
            </div>

            <div class="bonus-card">
                <h3>Featured Series</h3>
                <div class="bonus-item"><span class="bonus-date">Oct 6 - 12:</span> Halloween Series 1</div>
                <div class="bonus-item"><span class="bonus-date">Oct 13 - 19:</span> Halloween Series 2</div>
                <div class="bonus-item"><span class="bonus-date">Oct 20 - 26:</span> Hardcore Halloween Series 1</div>
                <div class="bonus-item"><span class="bonus-date">Oct 27 - Nov 2:</span> Hardcore Halloween Series 2</div>
            </div>

            <div class="bonus-card">
                <h3>Discounts</h3>
                <div class="bonus-item"><span class="discount-tag">FREE:</span> Fast Travel Fees, Sedative Ammo & Tomahawks (from Fence)</div>
                <div class="bonus-item"><span class="discount-tag">10 GOLD OFF:</span> Naturalist Sample Kit</div>
                <div class="bonus-item"><span class="discount-tag">50% OFF:</span> Halloween Masks (Madame Nazar), Melee Weapons, Haircuts, Dentistry, Makeup & Eyepatches</div>
                <div class="bonus-item"><span class="discount-tag">40% OFF:</span> Novice, Promising & Established Naturalist Items, Cripps' Outfits, Camp Dogs, Gypsy Cob & Missouri Fox Trotter Horses, Coats & Bandoliers</div>
            </div>

            <div class="bonus-card">
                <h3>Returning Clothing</h3>
                <ul class="bonus-list">
                    <li class="bonus-item">Folwell Hat</li>
                    <li class="bonus-item">Prieto Poncho</li>
                    <li class="bonus-item">Tied Pants</li>
                    <li class="bonus-item">Pelt Half Chaps</li>
                </ul>
            </div>

            <div class="bonus-card">
                <h3>Community Outfit</h3>
                <p class="bonus-credit">By Criggz628</p>
                <div class="bonus-item">Worn Flop Hat & Bandana</div>
                <div class="bonus-item">Laborer Overshirt (F) or Lautnip Shirt (M)</div>
                <div class="bonus-item">Leather Duster & Leather Gloves</div>
                <div class="bonus-item">Leather Pants & Military Half Chaps</div>
                <div class="bonus-item">Worn Ropers Boots</div>
            </div>
        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>
