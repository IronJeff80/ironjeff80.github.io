---
import Layout from '../layouts/Layout.astro';
---

<Layout
        title="Red Dead Bonuses | 2 Smokin' Barrels"
        description="New Red Dead Online event starts November 3: 3X on Trader Sales, 10X on Turkey Sales to the Butcher, Hardcore Pro Series, and weekly Pittman Outfit pieces all month."
        image="https://2smokinbarrels.com/images/rdo-bonuses-banner.jpg"
    >
    <main class="container">
        
        <header class="page-header">
            <h1 class="page-title">Red Dead Monthly</h1>
            <p class="date-range">November 3, 2026 — November 30, 2026</p>
            
            <div class="highlight-box highlight-box-left">
                <p>
                    A new Red Dead Online event starts on November 3 (available through November 30). 
                    Traders earn <span class="highlight-text">3X RDO$, XP & Role XP</span> on Trader Sales all month, plus <span class="highlight-pink">10X RDO$</span> on Turkey Sales to the Butcher, 
                    a monthlong Hardcore Pro Series, weekly pieces of the Pittman Outfit, and the Cordell Outfit and Coronation Buckle for logging in the week of Thanksgiving.
                </p>
            </div>
        </header>

        <div class="bonus-grid">
            <div class="bonus-card">
                <h3>Current Bonuses</h3>
                <div class="bonus-item"><span class="multiplier">10X</span> <strong>RDO$</strong> on Turkey Sales to the Butcher</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, XP & Role XP</strong> on Trader Sales</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Trade Route</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, Gold & XP</strong> on Featured Series</div>
                <div class="bonus-item"><span class="multiplier">2X</span> <strong>Trader Materials</strong> from Perfect Carcasses, Pelts, Skins & Hides</div>
            </div>

            <div class="bonus-card">
                <h3>Monthly Rewards</h3>
                <div class="bonus-item"><strong>Pittman Shirt</strong> (Outlaw Pass 2): Log in to receive.</div>
                <div class="bonus-item"><strong>Pittman Hat</strong> (Outlaw Pass 2): Traders can log in to receive.</div>
                <div class="bonus-item"><strong>Cordell Outfit</strong> (Outlaw Pass 1) & <strong>Coronation Buckle</strong>: Log in the week of Thanksgiving (Nov 23–30).</div>
            </div>

            <div class="bonus-card">
                <h3>Weekly Rewards</h3>
                <div class="bonus-item"><span class="bonus-date">Nov 3–9</span><br>Play twice to get the <strong>Pittman Neckerchief</strong> (Outlaw Pass 2)</div>
                <div class="bonus-item"><span class="bonus-date">Nov 10–16</span><br>Gain five Ranks as a Trader or reach Trader Rank 10 to receive the <strong>Pittman Pants</strong> (Outlaw Pass 2)</div>
                <div class="bonus-item"><span class="bonus-date">Nov 17–23</span><br>Complete a Role Challenge to receive the <strong>Pittman Boots</strong> (Outlaw Pass 2)</div>
                <div class="bonus-item"><span class="bonus-date">Nov 24–30</span><br>Gain five Ranks as a Trader or reach Trader Rank 15 to get the <strong>Pittman Coat</strong> (Outlaw Pass 2) and the <strong>Prairie Moon Camp Flag</strong></div>
            </div>

            <div class="bonus-card">
                <h3>Featured Series</h3>
                <div class="bonus-item"><span class="bonus-date">Nov 3–30:</span> Hardcore Pro Series</div>
            </div>

            <div class="bonus-card">
                <h3>Discounts</h3>
                <div class="bonus-item"><span class="discount-tag">5 GOLD BARS OFF:</span> Butcher's Table</div>
                <div class="bonus-item"><span class="discount-tag">50% OFF:</span> Hunting Wagon, Camp Flags & Themes, The Danube and The Tasman Outfits, Kladruber and Missouri Fox Trotter Horses, Varmint Rifle, Improved Bow, Pistols & Pistol Style Customization, Shirts, Pants & Boots</div>
            </div>

            <div class="bonus-card">
                <h3>Returning Limited-Time Outfits</h3>
                <ul class="bonus-list">
                    <li class="bonus-item">The Danube</li>
                    <li class="bonus-item">The Tasman</li>
                </ul>
            </div>

            <div class="bonus-card">
                <h3>Community-Inspired Outfit</h3>
                <p class="bonus-credit">By No_Reflection6759</p>
                <div class="bonus-item">Kennedy Hat</div>
                <div class="bonus-item">Winter Shotgun Coat</div>
                <div class="bonus-item">Opulent Vest</div>
                <div class="bonus-item">Heathland Chaps</div>
                <div class="bonus-item">Knitted Gloves</div>
                <div class="bonus-item">Millard Boots</div>
                <div class="bonus-item">Trimmed Bandana</div>
            </div>
        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>
