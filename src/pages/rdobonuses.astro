---
import Layout from '../layouts/Layout.astro';
---

<Layout
        title="Red Dead Bonuses | 2 Smokin' Barrels"
        description="Earn 3X RDO$, XP, and Gold on Telegram Missions, plus Triple Rewards on Collector Set Sales, waived Fast Travel fees, and a free Community-Inspired Outfit."
        image="https://2smokinbarrels.com/images/rdo-bonuses-banner.jpg"
    >
    <main class="container">
        
        <header style="margin-bottom: 3rem;">
            <h1 class="page-title">Red Dead Monthly</h1>
            <p class="date-range" style="text-align: center; color: var(--white-med); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">August 4, 2026 — August 31, 2026</p>
            
        <!-- Modernized Highlight Box -->
        <div style="background: rgba(38, 30, 62, 0.4); 
                    border-left: 5px solid var(--accent-pink); 
                    padding: 25px; 
                    margin-top: 20px; 
                    text-align: left; 
                    border-radius: 12px; 
                    backdrop-filter: blur(10px); 
                    border: 1px solid rgba(255, 255, 255, 0.05);">
                <p style="margin: 0; font-size: 1.1rem; color: var(--white-low);">
                    Earn <span style="color: var(--accent-orange); font-weight: 700;">3X RDO$, XP, and Gold</span> on all Telegram Missions this month (Gold excluded from A New Source of Employment). 
                    Collector Set Sales are paying out a massive <span style="color: var(--accent-pink); font-weight: 700;">3X RDO$, Role XP, and XP</span>. 
                    Plus, enjoy <span style="color: var(--accent-pink); font-weight: 700;">FREE Fast Travel</span> all month long!
                </p>
            </div>
        </header>

        <div class="bonus-grid">
            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Current Bonuses</h3>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, XP & Gold</strong> on Telegram Missions</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, Role XP & XP</strong> on Collector Set Sales</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Trade Route Free Roam Event</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Condor Egg Free Roam Event</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>Role XP</strong> for discovering Collectibles</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Featured Series</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Monthly Rewards</h3>
                <div class="bonus-item"><strong>Frontiersman Hat:</strong> Log in to receive.</div>
                <div class="bonus-item"><strong>Frontiersman Gloves:</strong> Discover two Collectibles during any week.</div>
                <div class="bonus-item"><strong>10 Gold Bars Off Role Item:</strong> Complete two Daily Challenges.</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Weekly Rewards</h3>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 4 - 10</span><br>Rank 10+ Collectors Log in: <strong>Frontiersman Pants & Belt</strong><br>Collect a Fossil: <strong>Blue Vaquero Baroque Spurs</strong></div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 11 - 17</span><br>Rank 10+ Collectors Log in: <strong>Frontiersman Boots & Half Chaps</strong><br>Complete all Collector Dailies: <strong>North Clingman Treasure Map</strong></div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 18 - 24</span><br>Rank 20 Collectors Log in: <strong>Frontiersman Shirt & Suspenders</strong><br>Complete Weekly Collection: <strong>Free Shirt</strong></div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 25 - 31</span><br>Rank 20 Collectors Log in: <strong>Frontiersman Neckerchief</strong><br>Win Featured Series: <strong>Burned Town Treasure Map</strong></div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Featured Series</h3>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 4 - 10:</span> Hardcore Elimination Series</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 11 - 17:</span> Takeover Series</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 18 - 24:</span> Explosive Series</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">August 25 - 31:</span> Hardcore Pro Series</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Discounts</h3>
                <div class="bonus-item"><span style="color: var(--accent-orange);">FREE:</span> Fast Travel Fees</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">5 GOLD OFF:</span> Collector's Bag</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">50% OFF:</span> Collector's Maps, Metal Detector, Ability Cards, Pennington Field Shovel, Shotguns & Shotgun Style Customizations</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">40% OFF:</span> Criollo Horses, Missouri Fox Trotter Horses, Ponchos, Chaps & Pants</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Returning Clothing</h3>
                <ul style="list-style: none; padding: 0; margin: 0;">
                    <li class="bonus-item">Griffith Chaps</li>
                    <li class="bonus-item">Menasco Hat</li>
                    <li class="bonus-item">Gardenia Hat</li>
                    <li class="bonus-item">Clymene Coat</li>
                    <li class="bonus-item">Cardozo Vest</li>
                </ul>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Community Outfit</h3>
                <p style="font-size: 0.8rem; font-style: italic; margin-bottom: 10px; color: var(--accent-pink);">By Victorian_Cowgirl</p>
                <div class="bonus-item">Owanjila Hat</div>
                <div class="bonus-item">Porter Jacket</div>
                <div class="bonus-item">Iniesta Shirtwaist (F) or Everyday Shirt (M)</div>
                <div class="bonus-item">Traditional Vest & Neckerchief</div>
                <div class="bonus-item">Bandito Pants</div>
                <div class="bonus-item">Bowyer Boots (F) or Dunsinnan Boots (M)</div>
            </div>
        </div>
        
        <div style="margin-top: 4rem; text-align: center;">
            <a href="/" style="color: var(--accent-pink); text-decoration: none; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">&larr; Back to Home</a>
        </div>
    </main>
</Layout>