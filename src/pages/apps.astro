---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stream Apps & Tools | 2 Smokin' Barrels"
        description="Explore custom overlays, widgets, and powerful streaming tools to level up your broadcast."
        image="https://2smokinbarrels.com/images/apps-banner.jpg"
    >
    <main class="container">
        <h1 class="page-title">Stream Apps & Tools</h1>
        <div class="highlight-box">
            <p>
                <span class="highlight-text">Explore custom overlays, widgets, and powerful streaming tools to level up your broadcast.</span>
            </p>
        </div>

        <!-- ============================================== -->
        <!-- SECTION 1: FEATURED APPS                       -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            Featured Overlays
        </h3>

        <div class="grid grid-featured">
            
            <!-- GTA Widget Card -->
            <div class="card">
                <span class="badge">Stream Widget</span>
                <h3>GTA Weather and Event Widget</h3>
                <p>
                    An OBS overlay that displays the current time and weather along with any limited Time Active Events such as Stoner Survival and Bigfoot Peyote.
                </p>
                <div class="btn-row">
                    <a href="https://2smokinbarrels.com/gtawidget/setup.html" target="_blank" class="cmd-btn">Configure</a>
                    <a href="https://github.com/IronJeff80/gtawidget" target="_blank" class="cmd-btn btn-secondary">Documentation</a>
                </div>
            </div>

            <!-- OBS Duel Mini Game -->
            <div class="card">
                <span class="badge">Stream Mini-Game</span>
                <h3>OBS Duel Game</h3>
                <p>
                    A fully automated, chat-triggered Western duel mini-game. Viewers can challenge each other in chat, triggering an interactive on-screen standoff in OBS complete with custom animations, avatars, and synchronized sound effects.
                </p>
                <div class="btn-row">
                    <a href="https://github.com/IronJeff80/OBS-Duel-Game" target="_blank" class="cmd-btn btn-secondary">Download Files</a>
                </div>
            </div>           

            <!-- Red Dead Overlay Widget Card -->
            <div class="card">
                <span class="badge">Stream Overlay</span>
                <h3>Red Dead Events Overlay</h3>
                <p>
                    An OBS overlay that displays Free Mode Events 10 minutes before each event starts. Designed to look exactly like the in game toast for FM Events.
                </p>
                <div class="btn-row">
                    <a href="https://2smokinbarrels.com/reddeadoverlay/" target="_blank" class="cmd-btn">Browser URL</a>
                    <a href="https://github.com/IronJeff80/reddeadoverlay" target="_blank" class="cmd-btn btn-secondary">Documentation</a>
                </div>
            </div>

        </div>

        <!-- ============================================== -->
        <!-- SECTION 2: PROGRAMS & CREATORS                 -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            Streaming Programs
        </h3>

        <div class="grid grid-creators">
            
            <!-- Streamer.Bot -->
            <div class="card card-center">
                <img src="/images/apps/streamerbot.png" alt="Streamer.Bot" class="app-icon">
                <h3>Streamer.Bot</h3>
                <p>
                    The ultimate automation and integration tool for live streamers. Take full control of your broadcast with powerful C# scripting and macro logic.
                </p>
                <div class="btn-row">
                    <a href="https://streamer.bot/" target="_blank" class="cmd-btn">Website</a>
                    <a href="https://streamer.bot/downloads" target="_blank" class="cmd-btn btn-secondary">Download</a>
                </div>
            </div>

            <!-- Speaker.Bot -->
            <div class="card card-center">
                <img src="/images/apps/speakerbot.png" alt="Speaker.Bot" class="app-icon">
                <h3>Speaker.Bot</h3>
                <p>
                    Advanced Text-to-Speech management designed to interface seamlessly with your channel rewards, voices, and bot automation triggers.
                </p>
                <div class="btn-row">
                    <a href="https://speaker.bot/" target="_blank" class="cmd-btn">Website</a>
                    <a href="https://speaker.bot/get-started/installation" target="_blank" class="cmd-btn btn-secondary">Download</a>
                </div>
            </div>

            <!-- VoiceMod -->
            <div class="card card-center">
                <img src="/images/apps/voicemod.png" alt="VoiceMod" class="app-icon">
                <h3>VoiceMod</h3>
                <p>
                    Real-time AI voice changer and soundboard software to bring immersive audio experiences and instant custom reactions straight to your stream audience.
                </p>
                <div class="btn-row">
                    <a href="https://www.voicemod.net/" target="_blank" class="cmd-btn">Website</a>
                    <a href="https://account.voicemod.net/#/?action=download" target="_blank" class="cmd-btn btn-secondary">Download</a>
                </div>
            </div>

        </div>

        <!-- Subheading for Integration Creators -->
        <h3 class="section-title section-divider">
            Integration Creators
        </h3>

        <div class="grid grid-creators">
            
            <!-- Tawmae -->
            <div class="card card-center">
                <img src="/images/apps/tawmae.jpg" alt="Tawmae" class="avatar-img">
                <h3>Tawmae</h3>
                <p>
                    A collection of custom-built Streamer.bot extensions for Twitch & YouTube. OBS & Meld overlays, games, utilities and integrations. And the best part? It all runs locally, even the overlays.
                </p>
                <div class="btn-stack">
                    <a href="https://tawmae.xyz/" target="_blank" class="cmd-btn btn-full">Website</a>
                    <div class="btn-row">
                        <a href="https://www.twitch.tv/tawmae" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                        <a href="https://www.youtube.com/@tawmae" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    </div>
                </div>
            </div>

            <!-- Mustached Maniac -->
            <div class="card card-center">
                <img src="/images/apps/mm.jpg" alt="Mustached Maniac" class="avatar-img">
                <h3>Mustached Maniac</h3>
                <p>
                    A highly questionable collection of projects, custom streaming experiments, and developer toolkits.
                </p>
                <div class="btn-stack">
                    <a href="https://mustachedmaniac.com/" target="_blank" class="cmd-btn btn-full">Website</a>
                    <div class="btn-row">
                        <a href="https://www.twitch.tv/mustached_maniac" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                        <a href="https://www.youtube.com/@mustached_maniac" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    </div>
                </div>
            </div>

            <!-- VRFlad -->
            <div class="card card-center">
                <img src="/images/apps/vrflad.jpg" alt="VRFlad" class="avatar-img">
                <h3>VRFlad</h3>
                <p>
                    I enjoy pushing what is possible with technology and I'm particularly passionate about VR. Streaming was never planned, but I love it and have been so fortunate to be able to give back to the amazing streaming community.
                </p>
                <div class="btn-stack">
                    <a href="https://vrflad.com/" target="_blank" class="cmd-btn btn-full">Website</a>
                    <div class="btn-row">
                        <a href="https://twitch.tv/VRFlad" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                        <a href="https://www.youtube.com/@vrflad" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- ============================================== -->
        <!-- SECTION 3: OBS MAINTAINERS & PLUGINS           -->
        <!-- ============================================== -->
        <h3 class="section-title section-divider">
            OBS Maintainers
        </h3>

        <div class="grid grid-creators">
            
            <!-- Exeldro -->
            <div class="card card-center">
                <img src="/images/apps/exeldro.png" alt="Exeldro" class="avatar-img">
                <h3>Exeldro</h3>
                <p>
                    Exeldro is a prominent software developer from the Netherlands, best known for creating dozens of highly popular plugins and tools for OBS Studio.
                </p>
                <div class="btn-stack">
                    <div class="btn-row">
                        <a href="https://exeldro.com/" target="_blank" class="cmd-btn">Website</a>
                        <a href="https://obsproject.com/forum/resources/authors/exeldro.128836/" target="_blank" class="cmd-btn btn-secondary">Resource List</a>
                    </div>
                    <div class="btn-row">
                        <a href="https://www.twitch.tv/Exeldro" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                        <a href="https://www.youtube.com/@exeldro" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    </div>
                </div>
            </div>

            <!-- FiniteSingularity -->
            <div class="card card-center">
                <img src="/images/apps/finite.jpg" alt="FiniteSingularity" class="avatar-img">
                <h3>FiniteSingularity</h3>
                <p>
                    FiniteSingularity is a developer, former academic, and educator with over 20 years of experience. He is best known in the streaming community for creating popular open-source plugins for OBS Studio.
                </p>
                <div class="btn-stack">
                    <div class="btn-row">
                        <a href="https://f15y.com/" target="_blank" class="cmd-btn">Website</a>
                        <a href="https://obsproject.com/forum/resources/authors/finitesingularity.370888/" target="_blank" class="cmd-btn btn-secondary">Resource List</a>
                    </div>
                    <div class="btn-row">
                        <a href="https://www.twitch.tv/finitesingularity" target="_blank" class="cmd-btn btn-twitch">Twitch</a>
                        <a href="https://www.youtube.com/@FSingularity" target="_blank" class="cmd-btn btn-youtube">YouTube</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Subheading for OBS Plugins -->
        <h3 class="section-title section-divider">
            Essential OBS Plugins
        </h3>

        <div class="grid grid-plugins">
            
            <div class="card card-center card-compact">
                <h4 class="plugin-title">Move</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/move.913/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Source Copy</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/source-copy.1261/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Downstream Keyer</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/downstream-keyer.1254/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Gradient Source</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/gradient-source.1172/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Advanced Masks</h4>
                <p class="plugin-author">By FiniteSingularity</p>
                <a href="https://obsproject.com/forum/resources/advanced-masks.1856/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Advanced Scene Switcher</h4>
                <p class="plugin-author">By Warmuptill</p>
                <a href="https://obsproject.com/forum/resources/advanced-scene-switcher.395/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Media Controls</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/media-controls.1032/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Tuna</h4>
                <p class="plugin-author">By univrsal</p>
                <a href="https://obsproject.com/forum/resources/tuna.843/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Quick Access Utility</h4>
                <p class="plugin-author">By FiniteSingularity</p>
                <a href="https://obsproject.com/forum/resources/quick-access-utility-qau.2002/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Source Clone</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/source-clone.1632/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Stroke Shadow Glow</h4>
                <p class="plugin-author">By FiniteSingularity</p>
                <a href="https://obsproject.com/forum/resources/stroke-glow-shadow.1800/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">Shader Filter</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/obs-shaderfilter.1736/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

            <div class="card card-center card-compact">
                <h4 class="plugin-title">3D Effect</h4>
                <p class="plugin-author">By Exeldro</p>
                <a href="https://obsproject.com/forum/resources/3d-effect.1692/" target="_blank" class="cmd-btn btn-full">View Plugin</a>
            </div>

        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>
