---
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/styles.css';

const { 
    title, 
    description = "Custom extensions, overlays, and technical tools for the Red Dead & GTA streaming community.",
    image = "https://2smokinbarrels.com/images/social-banner.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://2smokinbarrels.com/');
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Discord / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Ensure you create a 1200x630 banner and save it at this exact path! -->
    <meta property="og:image" content={image} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Links the Twitter Card to your specific X/Twitter account -->
    <meta name="twitter:site" content="@2_SmokinBarrels" />
    <meta name="twitter:creator" content="@2_SmokinBarrels" />

    <!-- Discord Embed Accent Color -->
    <meta name="theme-color" content="#375fcf" />
    
    <!-- Standard Favicon (Updated to your new SVG) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"> 
    
    <!-- Mobile Home Screen Icons -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <link rel="icon" type="image/png" href="/fav.png"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
    <div class="menu-overlay" id="menuOverlay" onclick="toggleSidebar()"></div>
    
    <Sidebar />
    <Header />

    <slot />

    <Footer />

    <script is:inline src="/js/app.js"></script>
</body>
</html>
