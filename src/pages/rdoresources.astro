---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Red Dead Resources | 2 Smokin' Barrels"
        description="Essential tools and interactive guides for navigating the frontier."
        image="https://2smokinbarrels.com/images/rdo-resources-banner.jpg"
    >
    <main class="container">
        <h1 class="page-title">Red Dead Resources</h1>
        <div class="highlight-box highlight-box-spaced">
            <p>
                <span class="highlight-text">Essential tools and interactive guides for navigating the frontier.</span>
            </p>
        </div>

        <div id="nazar-banner" class="resource-card nazar-hero">
            <div class="nazar-image-container">
                <img id="nazar-image" src="" alt="Madam Nazar Location">
            </div>
            <div class="nazar-info">
                <h3>Madam Nazar's Location</h3>
                <p id="nazar-location-text">Locating the spirits...</p>
            </div>
        </div>

        <div class="resource-grid">
            <a href="https://jeanropke.github.io/RDR2CollectorsMap/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-collector"></div>
                <div class="resource-info">
                    <h3>RDO Collector's Map</h3>
                    <p>The definitive interactive map for locating Madam Nazar and all daily hidden collectibles across the map.</p>
                </div>
            </a>

            <a href="https://jeanropke.github.io/RDOMap/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-rdomap"></div>
                <div class="resource-info">
                    <h3>Red Dead Online Map</h3>
                    <p>A comprehensive map detailing animal spawns, dynamic events, plant locations, and other crucial points of interest.</p>
                </div>
            </a>

            <a href="https://rdo-dailies.com/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-dailies"></div>
                <div class="resource-info">
                    <h3>Red Dead Dailies</h3>
                    <p>A quick reference guide for tracking current daily challenges to maintain streaks and efficiently earn gold.</p>
                </div>
            </a>

            <a href="https://red-dead-online-tool.github.io/Red-dead-tool/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-rdrtools"></div>
                <div class="resource-info">
                    <h3>Red Dead Tools</h3>
                    <p>A collection of tools to aid in Hunting, Collecting, Fishing and other tasks.</p>
                </div>
            </a>

            <a href="https://tjakubowski.github.io/rdo-naturalist/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-naturalist"></div>
                <div class="resource-info">
                    <h3>Interactive Field Guide</h3>
                    <p>An interactive companion to help track animal samples, hunt legendary spawns, and progress the Naturalist role.</p>
                </div>
            </a>

            <a href="https://rdr2map.com/" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-thumb thumb-rdr2map"></div>
                <div class="resource-info">
                    <h3>RDR2 Stroy Map</h3>
                    <p>Interactive Map of Red Dead Redemption 2 Locations. Find weapons, easter eggs, collectibles and more! Use the progress tracker to find everything you need!</p>
                </div>
            </a>
        </div>
        
        <div class="back-nav">
            <a href="/" class="back-link">&larr; Back to Home</a>
        </div>
    </main>
</Layout>
